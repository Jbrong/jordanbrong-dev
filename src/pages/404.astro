---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Page not found | ${SITE_TITLE}`} description="Page not found" />
		<meta name="robots" content="noindex" />
	</head>
	<body>
		<Header />
		<main>
			<h1>404</h1>
			<p>That page doesn't exist. Try the <a href="/">home page</a> or the <a href="/blog">blog</a>.</p>
		</main>
		<Footer />
	</body>
</html>
