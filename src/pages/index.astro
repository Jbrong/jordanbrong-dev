---
import { getPosts } from '../utils/posts';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getPosts())
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.posts {
				list-style: none;
				padding: 0;
			}
			.posts li {
				display: flex;
				flex-wrap: wrap;
				gap: 0 1em;
				margin-bottom: 0.5em;
			}
			.posts time {
				color: rgb(var(--gray));
				font-variant-numeric: tabular-nums;
				min-width: 7.5em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Hi, I'm Jordan.</h1>
			<!-- TODO(jordan): rewrite this intro in your own words. -->
			<p>
				I'm a DevOps engineer moving toward cloud security. I write about securing agentic
				workflows, AWS security, infrastructure evals, and hands-on experiments.
			</p>
			<h2>Recent posts</h2>
			{
				posts.length === 0 ? (
					<p>First posts coming soon.</p>
				) : (
					<>
						<ul class="posts">
							{posts.map((post) => (
								<li>
									<FormattedDate date={post.data.pubDate} />
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								</li>
							))}
						</ul>
						<p>
							<a href="/blog">All posts →</a>
						</p>
					</>
				)
			}
		</main>
		<Footer />
	</body>
</html>
