---
import { AUTHOR_NAME } from '../consts';
import SocialLinks from './SocialLinks.astro';

const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} {AUTHOR_NAME}
	<SocialLinks />
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	footer :global(.social-links) {
		justify-content: center;
		margin-top: 1em;
	}
	footer :global(.social-links a) {
		color: rgb(var(--gray));
	}
	footer :global(.social-links a:hover) {
		color: rgb(var(--gray-dark));
	}
</style>
